+// The repos this computer's Shepherdr server has tasks in (empty when it isn't running).
+async function shepherdrRepos() {
+  try {
+    const r = await fetch("http://127.0.0.1:7787/api/snapshot");
+    if (!r.ok) return new Set();
+    return new Set(((await r.json()).tasks ?? []).map((t) => t.repo).filter(Boolean));
+  } catch { return new Set(); }
+}
