+// >>> personal-herdr-desktop: on macOS the voice computer's mic and LFM3-Audio write it down
+// (vc dictate start|stop|cancel; Herdr Voice holds the mic permission). Linux keeps whisper.cpp.
+const VC = () => `${home()}/.local/bin/vc`;
+let vcFound;
+function voiceComputer() {
+  vcFound ??= home().startsWith("/Users/")
+    ? exec(VC(), ["status"]).then((r) => r.code === 0).catch(() => false)
+    : Promise.resolve(false);
+  return vcFound;
+}
