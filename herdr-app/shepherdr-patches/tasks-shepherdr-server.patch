+// This computer's Shepherdr server (project management: its spaces' tasks and worktrees). Its tasks that
+// herdr-task has no list entry for (matched by branch) show here too, one list per Shepherdr space, read-only:
+// a click opens Shepherdr's panel. Status from the server: need -> Needs you (its report's words), work ->
+// Working, ready, queued, todo, done as they are.
+const SHEPHERDR = "http://127.0.0.1:7787/api/snapshot";
+const SRV_SECTION = { need: "needs", work: "working", ready: "ready", merging: "merging", queued: "queued", todo: "todo", done: "done" };
+async function shepherdrLists(have) {
+  let snap;
+  try { const r = await fetch(SHEPHERDR); if (!r.ok) return []; snap = await r.json(); } catch { return []; }
+  const branches = new Set(have.flatMap((l) => l.tasks.map((t) => t.branch)).filter(Boolean));
+  const lists = new Map();
+  for (const k of snap.tasks ?? []) {
+    if (k.archived || (k.branch && branches.has(k.branch))) continue;
+    const place = (snap.places ?? []).find((p) => p.id === k.place);
+    const m = /^(.*)-(\d+)$/.exec(k.id ?? "");
+    if (!place || !m) continue;
+    const l = lists.get(place.id) ?? { slug: `shepherdr-${place.name}`, folder: k.repo ?? place.folder ?? place.name, name: place.name, prefix: m[1], server: true, tasks: [] };
+    l.tasks.push({ id: Number(m[2]), title: k.name, state: k.status === "done" ? "done" : k.status === "todo" ? "todo" : k.status === "queued" ? "queued" : "running",
+      branch: k.branch, worktree: k.folder, srv: { status: k.status, why: k.report?.msg ?? k.agent?.note ?? k.state ?? null, progress: k.report?.progress ?? null } });
+    lists.set(place.id, l);
+  }
+  return [...lists.values()];
+}
+function openShepherdr() {
+  const modTabs = new Set(panes().filter((p) => p.mod === "shepherdr").map((p) => p.tab));
+  for (const s of spaces()) {
+    const tab = (s.tabs ?? []).find((t) => modTabs.has(t.id));
+    if (tab) { if (!s.active) run("space.select", { id: s.id }); run("tab.select", { id: tab.id }); return; }
+  }
+  run("tab.new", { name: "Shepherdr", mod: "shepherdr" });
+}
