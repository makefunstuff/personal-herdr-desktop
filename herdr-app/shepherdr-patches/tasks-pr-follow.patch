+def pr_of_branch(s, task):
+    """A task whose pull request was opened outside Herdr (by hand, by an agent, before the board):
+    its branch's newest pull request on GitHub, recorded as the task's, so it is followed (checks,
+    merged: done) like one Herdr opened. Asked at most once per PR_EVERY; None when there is none."""
+    br, repo = task.get("branch"), github(s)
+    if not (br and repo) or now() - task.get("pr_looked", 0) < 60000:
+        return None
+    task["pr_looked"] = now()
+    s.dirty = True
+    ok, out, _ = gh("pr", "list", "--repo", repo, "--head", br, "--state", "all", "--limit", "1",
+                    "--json", "number,url")
+    try:
+        found = json.loads(out) if ok else []
+    except ValueError:
+        found = []
+    if not found:
+        return None
+    task["pr"] = {"number": found[0]["number"], "url": found[0]["url"], "repo": repo}
+    task.pop("pr_looked", None)
+    return task["pr"]
+
+
 def remote_of(main):
     names = git(main, "remote")[1].split()
     return "origin" if "origin" in names else (names[0] if names else "origin")
