+// Personal (this machine): in the hand-themed pixel layouts Shepherdr follows their look: square corners
+// everywhere and the theme's own status colours. Herdr's and Shepherdr's own layouts keep Shepherdr's look.
+const THEMED = new Set(["workbench", "fortress", "dos", "pixel"]);
+export const themed = () => THEMED.has(shared("layout"));
+// workbench writes its labels in capitals, like its own panels (SPACES, AGENTS, BUS 1 ...)
+const caps = (x) => (typeof x === "string" && shared("layout") === "workbench" ? x.toUpperCase() : x);
+{
+  // Square corners in the themed layouts. Installed once on the shared element prototype; every load of this
+  // module (each mod's copy, each reload) hands it the newest check, and a failing check never breaks a render.
+  const proto = Object.getPrototypeOf(div());
+  proto.__themedCheck = themed;
+  if (!proto.__themedRounded) {
+    const rounded = proto.rounded;
+    proto.__themedRounded = rounded;
+    proto.rounded = function (r) {
+      let square = false;
+      try { square = Boolean(proto.__themedCheck?.()); } catch { square = false; }
+      return rounded.call(this, square ? 0 : r);
+    };
+  }
+}
+// Personal (this machine): a measured size (on_size_change, a press's local position) in the units
+// widths and heights are given in. Herdr zoomed draws w(100) 160 px wide but measures it 160, so a
+// measurement fed back as a width or height would grow by that much each time. The chat's probe sets k.
+export const UNIT = (globalThis.__herdrUnit ??= { k: 1 });
+export function un(v) {
+  const k = UNIT.k || 1;
+  if (v == null) return v;
+  if (typeof v === "number") return v / k;
+  return { ...v, width: v.width / k, height: v.height / k };
+}
+// Corners: 6 on controls, 8 on cards (and hovers), 12 on bubbles (0 in the themed layouts).
+export const RADIUS = { get control() { return themed() ? 0 : 6; }, get card() { return themed() ? 0 : 8; }, get bubble() { return themed() ? 0 : 12; } };
 
