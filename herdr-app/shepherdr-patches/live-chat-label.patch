 export const agents = once("agents", liveAgents);
 export const panes = once("panes", livePanes);
-export const terminals = once("terminals", liveTerminals);
+// A parked agent's core label herdr.chat names its chat pane as the window that set it saw it: "vm/p1"
+// from a window elsewhere, "p1" from the machine's own window. Each window reads it in its own form
+// (the machine's prefix, or none here), so a machine with a Shepherdr window of its own and another
+// window that shows it agree on which chat an agent has, and neither's sweep (parked.js) ends it.
+// (personal-herdr-desktop patch: shepherdr-patches/live-chat-label.patch)
+const chatLabel = (k) => {
+  const l = k?.labels?.["herdr.chat"];
+  if (!l) return k;
+  const m = String(k.address ?? "").includes("/") ? k.address.split("/")[0] : "";
+  const local = l.includes("/") ? l.slice(l.indexOf("/") + 1) : l;
+  const want = m ? `${m}/${local}` : local;
+  return want === l ? k : { ...k, labels: { ...k.labels, "herdr.chat": want } };
+};
+export const terminals = once("terminals", () => liveTerminals().map(chatLabel));
 export const spaces = once("spaces", liveSpaces);
 
