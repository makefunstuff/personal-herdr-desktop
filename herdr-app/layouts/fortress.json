{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "px-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "px-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "px-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "px-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "px-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "px-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 3,
                    "color": "#7a5a1f"
                  },
                  "focus": {
                    "width": 3,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 14,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "px-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "px-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "desk",
              "type": "block",
              "content": {
                "mod": "desk"
              },
              "size": {
                "px": 360
              },
              "min": 300,
              "max": 600,
              "hidden": true
            },
            {
              "id": "shepherdr",
              "type": "block",
              "content": {
                "mod": "shepherdr",
                "props": {
                  "compact": true
                }
              },
              "size": {
                "px": 360
              },
              "min": 280,
              "max": 700,
              "hidden": true
            }
          ],
          "padding": 14,
          "gap": 14
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "px-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/fortress.svg",
    "fit": "cover"
  },
  "terminal_padding": [
    12,
    8
  ],
  "divider": {
    "width": 3,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "fortress",
  "font": "PxPlus IBM VGA 8x16",
  "font_size": 10.667,
  "ui_font": "Pixelated MS Sans Serif",
  "preview": "layouts/fortress.svg",
  "terminal_menu": "px-menu",
  "floating": [
    {
      "id": "voice",
      "content": {
        "mod": "voice"
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}