#!/bin/sh
# Mute or unmute Herdr typing sounds (macOS; herdr-keyclick checks this file on every key). In Herdr: cmd-alt-k.
f="$HOME/.local/state/herdr-typing-muted"
mkdir -p "$(dirname "$f")"
if [ -e "$f" ]; then rm -f "$f"; m="Typing sounds on"; else touch "$f"; m="Typing sounds off"; fi
osascript -e "display notification \"$m\" with title \"Herdr\"" >/dev/null 2>&1 || true
echo "$m"
